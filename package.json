{
  "name": "rommate",
  "version": "0.1.0",
  "description": "Download games from your RomM server straight into the right ES-DE folders, from Game Mode.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arunoruto/decky-rommate.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "romm",
    "roms",
    "emulation",
    "es-de",
    "steam-deck"
  ],
  "author": "Mirza Arnaut",
  "license": "MIT",
  "packageManager": "pnpm@12.9.0",
  "bugs": {
    "url": "https://github.com/arunoruto/decky-rommate/issues"
  },
  "homepage": "https://arunoruto.github.io/rommate/",
  "remote_binary_bundling": true,
  "remote_binary": [
    {
      "name": "rommate-linux-amd64",
      "url": "https://github.com/arunoruto/rommate/releases/download/v0.2.0/rommate-linux-amd64",
      "sha256hash": "2488a4eb17cad6b41cf170d9f9dacf0ba65ff46c921eabe56def833b76be8c1d"
    },
    {
      "name": "rommate-linux-arm64",
      "url": "https://github.com/arunoruto/rommate/releases/download/v0.2.0/rommate-linux-arm64",
      "sha256hash": "2a2be293e3b58cf62eb004dafb6f17f2b4bce98db66206489c16907caed3340c"
    }
  ],
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
